# ---------- Base de datos ----------
POSTGRES_USER=hooklab
POSTGRES_PASSWORD=hooklab
POSTGRES_DB=hooklab
DATABASE_URL=postgresql+psycopg://hooklab:hooklab@localhost:5432/hooklab

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Aplicación ----------
APP_ENV=development
LOG_LEVEL=INFO

# Base pública donde se reciben los webhooks (sin barra final)
PUBLIC_INGEST_BASE=http://localhost:8010

# Límite del cuerpo capturado, en bytes (1 MB)
MAX_BODY_BYTES=1048576

# Retención de endpoints anónimos, en horas
ANON_RETENTION_HOURS=72

# ---------- Secretos ----------
# Cifra signature_secret en reposo. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=cambiame-en-produccion

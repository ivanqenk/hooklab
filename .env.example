# ---------- Database ----------
POSTGRES_USER=hooklab
POSTGRES_PASSWORD=hooklab
POSTGRES_DB=hooklab
DATABASE_URL=postgresql+psycopg://hooklab:hooklab@localhost:5432/hooklab

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Application ----------
APP_ENV=development
LOG_LEVEL=INFO

# Public base where webhooks are received (no trailing slash).
PUBLIC_INGEST_BASE=http://localhost:8010

# Hard limit for a captured body, in bytes (1 MB).
MAX_BODY_BYTES=1048576

# How long anonymous endpoints live, in hours.
ANON_RETENTION_HOURS=72

# ---------- Secrets ----------
# Encrypts signature secrets at rest. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production
